# ==========================================
# CẤU HÌNH TURSO SQLITE CLOUD (ĐỒNG BỘ 24/7)
# ==========================================
# 1. Đăng ký tài khoản miễn phí tại: https://turso.tech
# 2. Tạo database (ví dụ: eduspark-db)
# 3. Dán URL và Token vào bên dưới hoặc vào phần Settings -> Environment Variables của Vercel:

TURSO_DATABASE_URL=libsql://eduspark-db-[username].turso.io
TURSO_AUTH_TOKEN=eyJh...[token_lay_tu_turso]

# (Nếu để trống 2 biến trên, hệ thống sẽ tự động dùng file SQLite cục bộ database/eduspark.db)
